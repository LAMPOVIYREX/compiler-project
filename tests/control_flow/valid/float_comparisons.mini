fn main() -> int {
    float x = 10.5;
    float y = 5.25;
    if (x > y) {
        if (x >= 10.0) {
            if (y < 10.0) {
                if (y <= 5.5) {
                    if (x != y) {
                        return 42;
                    }
                }
            }
        }
    }
    return 0;
}
