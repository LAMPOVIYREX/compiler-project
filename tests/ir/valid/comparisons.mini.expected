# MiniLang IR Program

function main: int ()

entry:
  [a] = MOVE 10
  [b] = MOVE 5
  t0 = CMP_GT [a], [b]
  [c1] = MOVE t0
  t1 = CMP_LT [a], [b]
  [c2] = MOVE t1
  t2 = CMP_GE [a], [b]
  [c3] = MOVE t2
  t3 = CMP_LE [a], [b]
  [c4] = MOVE t3
  t4 = CMP_EQ [a], [b]
  [c5] = MOVE t4
  t5 = CMP_NE [a], [b]
  [c6] = MOVE t5
  JUMP_IF_NOT [c1], sc_false_7
  t9 = MOVE [c6]
  JUMP sc_end_8

sc_false_7:
  t9 = MOVE 0

sc_end_8:
  JUMP_IF_NOT t9, endif_12

then_10:
  RETURN 1

endif_12:
  RETURN 0