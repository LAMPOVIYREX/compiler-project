# MiniLang IR Program

function isPositive: int ([x])

entry:
  t0 = CMP_GT [x], 0
  JUMP_IF_NOT t0, endif_3

then_1:
  RETURN 1

endif_3:
  RETURN 0

function main: int ()

entry:
  [a] = MOVE 5
  t0 = NEG 3
  [b] = MOVE t0
  t5 = CMP_GT [a], 0
  JUMP_IF_NOT t5, sc_false_2
  t6 = CMP_GT [b], 0
  t4 = MOVE t6
  JUMP sc_end_3

sc_false_2:
  t4 = MOVE 0

sc_end_3:
  JUMP_IF_NOT t4, endif_9

then_7:
  RETURN 1

endif_9:
  t13 = CMP_GT [a], 0
  JUMP_IF t13, sc_true_10
  t14 = CMP_GT [b], 0
  t12 = MOVE t14
  JUMP sc_end_11

sc_true_10:
  t12 = MOVE 1

sc_end_11:
  JUMP_IF_NOT t12, endif_17

then_15:
  RETURN 2

endif_17:
  RETURN 0