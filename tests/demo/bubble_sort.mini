fn main() -> int {
    int arr[3];
    arr[0] = 8;
    arr[1] = 3;
    arr[2] = 5;
    
    // Сортируем arr[0] и arr[1]
    int a0 = arr[0];
    int a1 = arr[1];
    if (a0 > a1) {
        arr[0] = a1;
        arr[1] = a0;
    }
    // arr = {3, 8, 5}
    
    // Сортируем arr[1] и arr[2]
    int b1 = arr[1];
    int b2 = arr[2];
    if (b1 > b2) {
        arr[1] = b2;
        arr[2] = b1;
    }
    // arr = {3, 5, 8}
    
    // Сортируем arr[0] и arr[1] ещё раз
    int c0 = arr[0];
    int c1 = arr[1];
    if (c0 > c1) {
        arr[0] = c1;
        arr[1] = c0;
    }
    // arr = {3, 5, 8}
    
    return arr[0] + arr[1] + arr[2];
    // 3 + 5 + 8 = 16
}
